{"q": "last 50 application errors", "cmd": "Get-WinEvent -FilterHashtable @{LogName = 'Application'; Level = 2} -MaxEvents 50"}
{"q": "dmesg", "cmd": "Get-WinEvent -LogName System -MaxEvents 50"}
{"q": "errors and warnings from the last 24 hours", "cmd": "Get-WinEvent -FilterHashtable @{LogName = 'System'; Level = 2, 3; StartTime = (Get-Date).AddDays(-1)}"}
{"q": "why did my pc restart", "cmd": "Get-WinEvent -FilterHashtable @{LogName = 'System'; Id = 41, 1074, 6008} -MaxEvents 10"}
{"q": "list wsl distros", "cmd": "wsl -l -v"}
{"q": "shut down wsl", "cmd": "wsl --shutdown"}
{"q": "open ubuntu in wsl", "cmd": "wsl -d Ubuntu"}
{"q": "run ls -la inside wsl", "cmd": "wsl ls -la"}
{"q": "install wsl", "cmd": "wsl --install"}
{"q": "generate an ssh key for me@example.com", "cmd": "ssh-keygen -t ed25519 -C 'me@example.com'"}
{"q": "ssh-keygen -t rsa -b 4096", "cmd": "ssh-keygen -t rsa -b 4096"}
{"q": "copy my public ssh key", "cmd": "Get-Content $HOME\\.ssh\\id_ed25519.pub | Set-Clipboard"}
{"q": "ssh into pi@192.168.1.50", "cmd": "ssh pi@192.168.1.50"}
{"q": "scp report.csv to user@server:/tmp", "cmd": "scp report.csv user@server:/tmp"}
{"q": "start ssh agent and add my key", "cmd": "Start-Service ssh-agent; ssh-add $HOME\\.ssh\\id_ed25519"}
{"q": "git status", "cmd": "git status"}
{"q": "undo last commit but keep changes", "cmd": "git reset --soft HEAD~1"}
{"q": "uncommit the last commit", "cmd": "git reset --soft HEAD~1"}
{"q": "throw away all local changes", "cmd": "git checkout -- ."}
{"q": "discard changes to app.js", "cmd": "git checkout -- app.js"}
{"q": "unstage everything", "cmd": "git reset"}
{"q": "delete local branches that are already merged", "cmd": "git branch --merged | Where-Object { $_ -notmatch '^\\*|\\bmain\\b|\\bmaster\\b' } | ForEach-Object { git branch -d $_.Trim() }"}
{"q": "pretty git log graph", "cmd": "git log --oneline --graph --all"}
{"q": "git log oneline last 10", "cmd": "git log --oneline -10"}
{"q": "who changed line 42 of src/app.ts", "cmd": "git blame -L 42,42 src/app.ts"}
{"q": "git blame utils.py", "cmd": "git blame utils.py"}
{"q": "show what changed in the last commit", "cmd": "git show --stat HEAD"}
{"q": "change last commit message to fix typo", "cmd": "git commit --amend -m 'fix typo'"}
{"q": "create and switch to branch feature/login", "cmd": "git checkout -b feature/login"}
{"q": "what branch am i on", "cmd": "git branch --show-current"}
{"q": "list all branches including remote", "cmd": "git branch -a"}
{"q": "stash my changes", "cmd": "git stash"}
{"q": "get my stash back", "cmd": "git stash pop"}
{"q": "commit everything with message wip", "cmd": "git add -A; git commit -m 'wip'"}
{"q": "push new branch to origin", "cmd": "git push -u origin HEAD"}
{"q": "pull with rebase", "cmd": "git pull --rebase"}
{"q": "remote url of this repo", "cmd": "git remote -v"}
{"q": "files changed between main and my branch", "cmd": "git diff --name-only main...HEAD"}
{"q": "docker ps", "cmd": "docker ps"}
{"q": "show all containers including stopped", "cmd": "docker ps -a"}
{"q": "stop all running containers", "cmd": "docker stop (docker ps -q)"}
{"q": "remove all stopped containers", "cmd": "docker container prune"}
{"q": "clean up docker everything unused", "cmd": "docker system prune -a"}
{"q": "docker images", "cmd": "docker images"}
{"q": "follow logs of the api container", "cmd": "docker logs -f api"}
{"q": "get a shell in container web", "cmd": "docker exec -it web sh"}
{"q": "compose up in background", "cmd": "docker compose up -d"}
{"q": "docker compose down and remove volumes", "cmd": "docker compose down -v"}
{"q": "rebuild compose services", "cmd": "docker compose up -d --build"}
{"q": "how much disk is docker using", "cmd": "docker system df"}
{"q": "npm install", "cmd": "npm install"}
{"q": "clean install from lockfile", "cmd": "npm ci"}
{"q": "nuke node_modules and reinstall", "cmd": "Remove-Item node_modules -Recurse -Force; npm install"}
{"q": "which npm packages are outdated", "cmd": "npm outdated"}
{"q": "globally installed npm packages", "cmd": "npm ls -g --depth=0"}
{"q": "run the dev script", "cmd": "npm run dev"}
{"q": "what scripts are in package.json", "cmd": "(Get-Content package.json -Raw | ConvertFrom-Json).scripts"}
{"q": "clear npm cache", "cmd": "npm cache clean --force"}
{"q": "pip install -r requirements.txt", "cmd": "pip install -r requirements.txt"}
{"q": "pip freeze > requirements.txt", "cmd": "pip freeze | Set-Content requirements.txt"}
{"q": "outdated pip packages", "cmd": "pip list --outdated"}
{"q": "upgrade pip", "cmd": "python -m pip install --upgrade pip"}
{"q": "uninstall requests with pip", "cmd": "pip uninstall requests"}
{"q": "version field from package.json", "cmd": "(Get-Content package.json -Raw | ConvertFrom-Json).version"}
{"q": "cat data.json | jq .users", "cmd": "(Get-Content data.json -Raw | ConvertFrom-Json).users"}
{"q": "pretty print config.json", "cmd": "Get-Content config.json -Raw | ConvertFrom-Json | ConvertTo-Json -Depth 10"}
{"q": "names of all users in users.json", "cmd": "(Get-Content users.json -Raw | ConvertFrom-Json) | ForEach-Object { $_.name }"}
{"q": "dependencies listed in package.json", "cmd": "(Get-Content package.json -Raw | ConvertFrom-Json).dependencies"}
{"q": "set version to 2.0.0 in package.json", "cmd": "$j = Get-Content package.json -Raw | ConvertFrom-Json; $j.version = '2.0.0'; $j | ConvertTo-Json -Depth 10 | Set-Content package.json"}
{"q": "show sales.csv as a table", "cmd": "Import-Csv sales.csv | Format-Table"}
{"q": "how many rows in sales.csv", "cmd": "(Import-Csv sales.csv | Measure-Object).Count"}
{"q": "rows in people.csv where age is over 30", "cmd": "Import-Csv people.csv | Where-Object { [int]$_.Age -gt 30 }"}
{"q": "column names of data.csv", "cmd": "(Import-Csv data.csv | Select-Object -First 1).PSObject.Properties.Name"}
{"q": "sum the amount column in orders.csv", "cmd": "(Import-Csv orders.csv | Measure-Object Amount -Sum).Sum"}
{"q": "convert data.csv to json", "cmd": "Import-Csv data.csv | ConvertTo-Json | Set-Content data.json"}
{"q": "export process list to procs.csv", "cmd": "Get-Process | Select-Object Name, Id, CPU | Export-Csv procs.csv -NoTypeInformation"}
{"q": "base64 encode hello world", "cmd": "[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes('hello world'))"}
{"q": "echo aGVsbG8= | base64 -d", "cmd": "[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('aGVsbG8='))"}
{"q": "base64 of logo.png", "cmd": "[Convert]::ToBase64String([IO.File]::ReadAllBytes(\"$PWD\\logo.png\"))"}
{"q": "url encode a b&c", "cmd": "[uri]::EscapeDataString('a b&c')"}
{"q": "generate a guid", "cmd": "New-Guid"}
{"q": "uuidgen", "cmd": "[guid]::NewGuid().ToString()"}
{"q": "generate a random 16 char password", "cmd": "-join ((48..57) + (65..90) + (97..122) | Get-Random -Count 16 | ForEach-Object { [char]$_ })"}
{"q": "random number between 1 and 100", "cmd": "Get-Random -Minimum 1 -Maximum 101"}
{"q": "sleep 10", "cmd": "Start-Sleep -Seconds 10"}
{"q": "wait half a second", "cmd": "Start-Sleep -Milliseconds 500"}
{"q": "time npm run build", "cmd": "Measure-Command { npm run build }"}
{"q": "how long does pytest take", "cmd": "Measure-Command { pytest }"}
{"q": "run tests and show their output and the time it took", "cmd": "Measure-Command { npm test | Out-Default }"}
{"q": "watch -n 5 docker ps", "cmd": "while ($true) { Clear-Host; docker ps; Start-Sleep -Seconds 5 }"}
{"q": "repeat ping until ctrl c", "cmd": "Test-Connection google.com -Continuous"}
{"q": "shutdown now", "cmd": "Stop-Computer"}
{"q": "restart the computer", "cmd": "Restart-Computer"}
{"q": "lock my screen", "cmd": "rundll32.exe user32.dll,LockWorkStation"}
{"q": "calculate 1234 * 5678", "cmd": "1234 * 5678"}
{"q": "how many bytes is 3.5 gb", "cmd": "3.5GB"}
{"q": "seq 1 10", "cmd": "1..10"}
{"q": "echo hello > out.txt", "cmd": "Set-Content out.txt 'hello'"}
