{"q": "beep when the build finishes", "cmd": "npm run build; [console]::Beep()"}
{"q": "cmd /c dir", "cmd": "cmd /c dir"}
{"q": "reverse lines of list.txt", "cmd": "$l = Get-Content list.txt; [array]::Reverse($l); $l"}
{"q": "uppercase the text in name.txt", "cmd": "(Get-Content name.txt -Raw).ToUpper()"}
