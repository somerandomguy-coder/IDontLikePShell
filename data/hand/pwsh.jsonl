{"q": "show logged in users", "cmd": "quser"}
{"q": "list local users", "cmd": "Get-LocalUser"}
{"q": "which groups am i in", "cmd": "whoami /groups"}
{"q": "firewall rules that are enabled for inbound", "cmd": "Get-NetFirewallRule -Direction Inbound -Enabled True"}
{"q": "windows defender status", "cmd": "Get-MpComputerStatus"}
{"q": "startup programs", "cmd": "Get-CimInstance Win32_StartupCommand | Select-Object Name, Command, Location"}
{"q": "get the module list", "cmd": "Get-Module -ListAvailable"}
{"q": "help for copy-item with examples", "cmd": "Get-Help Copy-Item -Examples"}
{"q": "man ls", "cmd": "Get-Help Get-ChildItem"}
{"q": "what properties does get-process return", "cmd": "Get-Process | Get-Member"}
{"q": "count lines of output from git log", "cmd": "(git log --oneline | Measure-Object).Count"}
{"q": "how many commits do i have on this branch", "cmd": "git rev-list --count HEAD"}
