{"q": "convert file.txt to utf8", "cmd": "(Get-Content file.txt) | Set-Content file.txt -Encoding UTF8"}
{"q": "make a 100mb dummy file", "cmd": "fsutil file createnew dummy.bin 104857600"}
{"q": "show cert expiry for google.com", "cmd": "$t = New-Object Net.Sockets.TcpClient('google.com', 443); $s = New-Object Net.Security.SslStream($t.GetStream()); $s.AuthenticateAsClient('google.com'); $s.RemoteCertificate.GetExpirationDateString(); $t.Close()"}
