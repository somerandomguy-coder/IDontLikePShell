{"q": "serach for todo in pyhton files", "cmd": "rg -t py 'TODO'"}
{"q": "grpe -i error logs", "cmd": "rg -i 'error' logs"}
{"q": "grep -rn \"password\" .", "cmd": "rg 'password'"}
{"q": "grep -rni 'select \\*' --include=*.cs", "cmd": "rg -i -g '*.cs' 'select \\*'"}
{"q": "grep -r \"Authorization\" --include=*.ts --include=*.tsx", "cmd": "rg -g '*.ts' -g '*.tsx' 'Authorization'"}
{"q": "grep -rl 'jquery' public", "cmd": "rg -l 'jquery' public"}
{"q": "count lines with 200 in access.log", "cmd": "rg -c ' 200 ' access.log"}
{"q": "grep -o 'v[0-9]\\+\\.[0-9]\\+' CHANGELOG.md", "cmd": "rg -o 'v\\d+\\.\\d+' CHANGELOG.md"}
{"q": "grep -v node_modules", "cmd": "rg -v 'node_modules'"}
{"q": "lines in requirements.txt that arent pinned", "cmd": "rg -v '==' requirements.txt"}
{"q": "grep -A 20 'def handler' lambda.py", "cmd": "rg -A 20 'def handler' lambda.py"}
{"q": "grep --color 'ERROR' logs/*.log", "cmd": "rg -g '*.log' 'ERROR' logs"}
{"q": "grep -rn 'interface I' --include=*.cs src", "cmd": "rg -g '*.cs' 'interface I' src"}
{"q": "grep -rn 'class .*Controller'", "cmd": "rg 'class .*Controller'"}
{"q": "grep -r --include=Dockerfile FROM", "cmd": "rg -g 'Dockerfile' 'FROM'"}
{"q": "grep -ri 'cors' appsettings.Development.json", "cmd": "rg -i 'cors' appsettings.Development.json"}
{"q": "search scripts for the literal --force flag", "cmd": "rg -F -e '--force' scripts"}
{"q": "grep -P '\\d{3}-\\d{4}'", "cmd": "rg '\\d{3}-\\d{4}'"}
{"q": "grep -x 'done'", "cmd": "rg '^done$'"}
{"q": "look for 'TODO' but only the first 3 per file", "cmd": "rg -m 3 'TODO'"}
{"q": "find where the port 8080 is set", "cmd": "rg -F '8080'"}
{"q": "any references to the old api.example.com host", "cmd": "rg -F 'api.example.com'"}
{"q": "which files use HttpClient directly", "cmd": "rg -l -w 'HttpClient'"}
{"q": "count HttpClient uses per file", "cmd": "rg -c -w 'HttpClient'"}
{"q": "total matches of 'any' in ts, whole word", "cmd": "(rg -w -t ts -o 'any' | Measure-Object).Count"}
{"q": "ts-ignore comments", "cmd": "rg -F '@ts-ignore'"}
{"q": "[Obsolete] attributes", "cmd": "rg -F '[Obsolete'"}
{"q": "sql SELECT * anywhere, any case", "cmd": "rg -i 'select \\*'"}
{"q": "TODO in yaml but skip the charts dir", "cmd": "rg -t yaml -g '!charts' 'TODO'"}
{"q": "node-version in .github", "cmd": "rg 'node-version' .github"}
{"q": "only the matching part for semver strings", "cmd": "rg -o '\\d+\\.\\d+\\.\\d+'"}
{"q": "replace http with https in output, just preview", "cmd": "rg -r 'https://' 'http://'"}
{"q": "show image tags only, strip 'image:'", "cmd": "rg -o -r '$1' '^\\s*image:\\s*(.+)$'"}
{"q": "multiline: a using block followed by a return on the next line", "cmd": "rg -U 'using \\(.*\\)\\s*\\n\\s*return'"}
{"q": "lines with async and then await on the same line", "cmd": "rg 'async.*await'"}
{"q": "show files with TODO sorted by path", "cmd": "rg -l --sort path 'TODO'"}
{"q": "recent log hits first, ERROR in logs", "cmd": "rg --sortr modified 'ERROR' logs"}
{"q": "count Exception matches in each .log file", "cmd": "rg --count-matches -g '*.log' 'Exception'"}
{"q": "how many lines in app.log have WARN", "cmd": "(rg 'WARN' app.log | Measure-Object).Count"}
{"q": "does any file still say 'lorem ipsum'", "cmd": "rg -i -l 'lorem ipsum'"}
