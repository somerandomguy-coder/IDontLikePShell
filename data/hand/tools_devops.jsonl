{"q": "emulators with saved data in emu-data", "cmd": "firebase emulators:start --import ./emu-data --export-on-exit"}
{"q": "list firebase projects", "cmd": "firebase projects:list"}
{"q": "switch firebase project to prod", "cmd": "firebase use prod"}
{"q": "firebase functions logs", "cmd": "firebase functions:log"}
{"q": "list deployed cloud functions in firebase", "cmd": "firebase functions:list"}
{"q": "set up firebase in this folder", "cmd": "firebase init"}
{"q": "tailscale status", "cmd": "tailscale status"}
{"q": "my tailscale ip", "cmd": "tailscale ip -4"}
{"q": "ping laptop over tailscale", "cmd": "tailscale ping laptop"}
{"q": "connect to my tailnet", "cmd": "tailscale up"}
{"q": "disconnect tailscale", "cmd": "tailscale down"}
{"q": "use home-server as exit node", "cmd": "tailscale set --exit-node=home-server"}
{"q": "stop using the exit node", "cmd": "tailscale set --exit-node="}
{"q": "share local port 3000 on my tailnet", "cmd": "tailscale serve 3000"}
{"q": "expose port 3000 to the internet with funnel", "cmd": "tailscale funnel 3000"}
{"q": "tailscale netcheck", "cmd": "tailscale netcheck"}
{"q": "send photo.jpg to my phone over tailscale", "cmd": "tailscale file cp photo.jpg phone:"}
{"q": "tailnet peers as json", "cmd": "tailscale status --json"}
{"q": "who is 100.64.0.5", "cmd": "tailscale whois 100.64.0.5"}
{"q": "winget search postgres", "cmd": "winget search postgres"}
{"q": "install node lts", "cmd": "winget install OpenJS.NodeJS.LTS"}
{"q": "install ripgrep by exact id", "cmd": "winget install --id BurntSushi.ripgrep.MSVC -e"}
{"q": "details on the Git.Git package", "cmd": "winget show Git.Git"}
{"q": "upgrade just powershell", "cmd": "winget upgrade Microsoft.PowerShell"}
{"q": "export my installed apps to apps.json", "cmd": "winget export -o apps.json"}
{"q": "reinstall everything from apps.json", "cmd": "winget import -i apps.json"}
{"q": "install docker desktop", "cmd": "winget install Docker.DockerDesktop"}
{"q": "brew install jq", "cmd": "winget install jqlang.jq"}
{"q": "winget list | grep python", "cmd": "winget list python"}
{"q": "wsl -l -v", "cmd": "wsl -l -v"}
{"q": "which wsl version are my distros on", "cmd": "wsl -l -v"}
{"q": "stop the ubuntu distro", "cmd": "wsl --terminate Ubuntu"}
{"q": "make Debian the default wsl distro", "cmd": "wsl --set-default Debian"}
{"q": "update wsl", "cmd": "wsl --update"}
{"q": "wsl status", "cmd": "wsl --status"}
{"q": "back up ubuntu to ubuntu.tar", "cmd": "wsl --export Ubuntu ubuntu.tar"}
{"q": "import ubuntu.tar as a new distro called dev", "cmd": "wsl --import dev C:\\wsl\\dev ubuntu.tar"}
{"q": "run uname -a in debian", "cmd": "wsl -d Debian uname -a"}
{"q": "open wsl in my linux home", "cmd": "wsl ~"}
{"q": "distros i can install", "cmd": "wsl -l -o"}
{"q": "open wsl as root", "cmd": "wsl -u root"}
{"q": "install the local dev CA", "cmd": "mkcert -install"}
{"q": "cert for localhost", "cmd": "mkcert localhost"}
{"q": "https cert for myapp.test and localhost", "cmd": "mkcert myapp.test localhost 127.0.0.1 ::1"}
{"q": "wildcard cert for *.dev.test", "cmd": "mkcert '*.dev.test'"}
{"q": "where is the mkcert ca stored", "cmd": "mkcert -CAROOT"}
{"q": "localhost cert as cert.pem and key.pem", "cmd": "mkcert -cert-file cert.pem -key-file key.pem localhost"}
{"q": "pfx cert for localhost", "cmd": "mkcert -pkcs12 localhost"}
{"q": "self signed cert for local dev", "cmd": "mkcert localhost 127.0.0.1 ::1"}
{"q": "remove the mkcert ca from the trust store", "cmd": "mkcert -uninstall"}
{"q": "random 32 byte hex string", "cmd": "openssl rand -hex 32"}
{"q": "random base64 secret with openssl", "cmd": "openssl rand -base64 48"}
{"q": "view github.com cert with openssl", "cmd": "$null | openssl s_client -connect github.com:443 -servername github.com | openssl x509 -noout -text"}
{"q": "when does example.com's cert expire", "cmd": "$null | openssl s_client -connect example.com:443 -servername example.com | openssl x509 -noout -dates"}
{"q": "full cert chain of example.com", "cmd": "$null | openssl s_client -connect example.com:443 -servername example.com -showcerts"}
{"q": "show cert.pem details", "cmd": "openssl x509 -in cert.pem -noout -text"}
{"q": "subject and issuer of server.crt", "cmd": "openssl x509 -in server.crt -noout -subject -issuer"}
{"q": "sha256 fingerprint of cert.pem", "cmd": "openssl x509 -in cert.pem -noout -fingerprint -sha256"}
{"q": "openssl self signed cert for localhost valid a year", "cmd": "openssl req -x509 -newkey rsa:2048 -noenc -keyout key.pem -out cert.pem -days 365 -subj '/CN=localhost'"}
{"q": "bundle cert.pem and key.pem into cert.pfx with openssl", "cmd": "openssl pkcs12 -export -out cert.pfx -inkey key.pem -in cert.pem"}
{"q": "sha256 of setup.exe using openssl", "cmd": "openssl dgst -sha256 setup.exe"}
{"q": "get json from localhost:3000/api/users", "cmd": "curl.exe http://localhost:3000/api/users"}
{"q": "post json name bob to localhost:3000/api/users", "cmd": "curl.exe -X POST http://localhost:3000/api/users -H 'Content-Type: application/json' -d '{\\\"name\\\":\\\"bob\\\"}'"}
{"q": "curl post {\"email\":\"a@b.com\"} to localhost:8080/subscribe", "cmd": "curl.exe -X POST http://localhost:8080/subscribe -H 'Content-Type: application/json' -d '{\\\"email\\\":\\\"a@b.com\\\"}'"}
{"q": "put json name alice on user 5", "cmd": "curl.exe -X PUT http://localhost:3000/api/users/5 -H 'Content-Type: application/json' -d '{\\\"name\\\":\\\"alice\\\"}'"}
{"q": "patch user 5 set active false", "cmd": "curl.exe -X PATCH http://localhost:3000/api/users/5 -H 'Content-Type: application/json' -d '{\\\"active\\\":false}'"}
{"q": "curl delete user 5", "cmd": "curl.exe -X DELETE http://localhost:3000/api/users/5"}
{"q": "post data.json to localhost:3000/api/import", "cmd": "curl.exe -X POST http://localhost:3000/api/import -H 'Content-Type: application/json' -d '@data.json'"}
{"q": "headers only for google.com", "cmd": "curl.exe -I https://google.com"}
{"q": "curl and follow redirects http://github.com", "cmd": "curl.exe -L http://github.com"}
{"q": "download node zip to node.zip with curl", "cmd": "curl.exe -L -o node.zip https://nodejs.org/dist/v20.11.0/node-v20.11.0-win-x64.zip"}
{"q": "call api.example.com/me with my API_TOKEN env var as bearer", "cmd": "curl.exe -H \"Authorization: Bearer $env:API_TOKEN\" https://api.example.com/me"}
{"q": "curl -v https://example.com", "cmd": "curl.exe -v https://example.com"}
{"q": "response headers plus body", "cmd": "curl.exe -i https://httpbin.org/get"}
{"q": "just the http status code of example.com", "cmd": "curl.exe -s -o NUL -w '%{http_code}' https://example.com"}
{"q": "health check localhost:8080 with 5s timeout", "cmd": "curl.exe -s --max-time 5 http://localhost:8080/health"}
{"q": "whats my public ip", "cmd": "curl.exe ifconfig.me"}
{"q": "curl local https ignoring cert errors", "cmd": "curl.exe -k https://localhost:8443"}
{"q": "upload photo.jpg as multipart to localhost:3000/upload", "cmd": "curl.exe -F 'file=@photo.jpg' http://localhost:3000/upload"}
{"q": "form post name=bob&age=30", "cmd": "curl.exe -X POST -d 'name=bob&age=30' http://localhost:3000/form"}
{"q": "send header X-Api-Key abc to localhost:3000", "cmd": "curl.exe -H 'X-Api-Key: abc' http://localhost:3000"}
{"q": "any prs assigned to me", "cmd": "gh pr list --assignee '@me'"}
{"q": "mark pr 14 ready for review", "cmd": "gh pr ready 14"}
{"q": "comment 'lgtm' on pr 8", "cmd": "gh pr comment 8 --body 'lgtm'"}
{"q": "reopen issue 3", "cmd": "gh issue reopen 3"}
{"q": "issues mentioning timeout", "cmd": "gh issue list --search 'timeout'"}
{"q": "why did the last ci run fail", "cmd": "gh run view --log-failed"}
{"q": "rerun failed jobs of run 987654", "cmd": "gh run rerun 987654 --failed"}
{"q": "list workflows", "cmd": "gh workflow list"}
{"q": "gh repo view --web", "cmd": "gh repo view --web"}
{"q": "show stash list then pop the 2nd one", "cmd": "git stash list; git stash pop 'stash@{1}'"}
{"q": "stash only staged changes", "cmd": "git stash push --staged"}
{"q": "continue the cherry pick", "cmd": "git cherry-pick --continue"}
{"q": "rename remote origin to old", "cmd": "git remote rename origin old"}
{"q": "prune stale remote-tracking branches from origin", "cmd": "git remote prune origin"}
{"q": "tags pointing at HEAD", "cmd": "git tag --points-at HEAD"}
{"q": "tags matching v1.*", "cmd": "git tag -l 'v1.*'"}
{"q": "commits on main since v1.0", "cmd": "git log --oneline v1.0..main"}
{"q": "files changed by alice in the last month", "cmd": "git log --author='alice' --since='1 month ago' --name-only --format=''"}
{"q": "logs for every service in compose but only errors", "cmd": "docker compose logs | rg -i 'error'"}
{"q": "restart api and worker services", "cmd": "docker compose restart api worker"}
{"q": "remove compose orphans while bringing it down", "cmd": "docker compose down --remove-orphans"}
{"q": "show container sizes", "cmd": "docker ps -s"}
