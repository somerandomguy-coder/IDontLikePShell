{"q": "watch the rollout of deployment worker", "cmd": "kubectl rollout status deployment/worker"}
{"q": "kubectl get pods -o yaml for web-0", "cmd": "kubectl get pod web-0 -o yaml"}
{"q": "pull nomic-embed-text", "cmd": "ollama pull nomic-embed-text"}
{"q": "remove llama2 and mistral", "cmd": "ollama rm llama2 mistral"}
{"q": "wsl shutdown then start ubuntu", "cmd": "wsl --shutdown; wsl -d Ubuntu"}
